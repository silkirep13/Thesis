# Instrument-classifier training data: raw source audio plus the intermediates
# regenerated by prepare_dataset.py. The TRAINED model under
# instrument_classifier/models/ is deliberately NOT ignored — the backend
# loads it at runtime, so it has to ship with the code.
backend/instrument_classifier/data/

# Local scratch space for test audio and throwaway output
scratchpad/
